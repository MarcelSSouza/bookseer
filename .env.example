# Copy this file to .env and fill in what you have.
# Nothing here is strictly required — BookSeer degrades gracefully and only
# needs the integration for the specific feature/release type you use.
# See README.md for the full explanation of each variable.

PORT=3000

# Where finished books land, organized as Author/Title.ext
LIBRARY_DIR=/downloads/books

# --- Prowlarr (optional: enables searching your own Usenet/torrent indexers) ---
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
PROWLARR_EBOOK_CATEGORIES=7020
PROWLARR_AUDIOBOOK_CATEGORIES=3030

# --- SABnzbd (optional: only needed for Usenet-protocol releases) ---
SABNZBD_URL=http://sabnzbd:9876
SABNZBD_API_KEY=
SABNZBD_CATEGORY=books
# Only set these two if BookSeer's container sees the shared downloads
# volume at a DIFFERENT path than SABnzbd's own container does.
SABNZBD_CONTAINER_DOWNLOADS_ROOT=/downloads
SABNZBD_LOCAL_DOWNLOADS_ROOT=/downloads

# --- TorBox (optional: only needed for torrent-protocol releases) ---
TORBOX_API_KEY=

# --- Libgen (works out of the box, no key needed) ---
LIBGEN_BASE=https://libgen.li
